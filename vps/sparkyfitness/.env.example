# Secrets & Passwords
POSTGRES_PASSWORD=your_postgres_password_here
SPARKY_FITNESS_APP_DB_PASSWORD=your_app_db_password_here
SPARKY_FITNESS_API_ENCRYPTION_KEY=your_64_hex_character_key_here
BETTER_AUTH_SECRET=your_better_auth_secret_here
