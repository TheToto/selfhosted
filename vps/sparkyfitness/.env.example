DOMAIN_NAME=example.com
PUID=1000
GUID=1000

# Generic SMTP Configuration
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password_here

# ==========================================
# SparkyFitness Specific Configuration
# ==========================================
