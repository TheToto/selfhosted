# Configuration domaine & timezone
DOMAIN_NAME=thetoto.fr
TZ=Europe/Paris

# Mot de passe d'administration Stalwart (compte: admin)
# Utilisé lors du bootstrap initial pour l'interface admin (https://mail.thetoto.fr)
STALWART_ADMIN_PASSWORD=ChangeMeStrongPassword123!

# Clé de session secrète pour Bulwark Webmail (chiffrement sessions et sync des réglages)
# Générez une clé aléatoire avec : openssl rand -base64 32
BULWARK_SESSION_SECRET=ChangeMeGeneratedSecretKeyBase64==
