{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'Europe/Paris',
  'docker-compose': {
    managerFilePatterns: [
      '/^.*\\.ya?ml$/',
    ],
  },
  assignees: [
    'TheToto',
  ],
  automerge: false,
  ignoreTests: true,
  automergeSchedule: [
    'after 1:00am and before 6:00am',
  ],
  packageRules: [
    {
      matchFileNames: [
        'vps/**',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      groupName: 'vps (non-major)',
      automerge: true,
    },
    {
      matchFileNames: [
        'vps/**',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '!/^0/',
      groupName: 'vps (non-major)',
      automerge: true,
    },
    {
      matchFileNames: [
        'media/**',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      groupName: 'media (non-major)',
      automerge: true,
    },
    {
      matchFileNames: [
        'media/**',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '!/^0/',
      groupName: 'media (non-major)',
      automerge: true,
    },
    {
      matchFileNames: [
        'monitor/**',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      groupName: 'monitor (non-major)',
      automerge: true,
    },
    {
      matchFileNames: [
        'monitor/**',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '!/^0/',
      groupName: 'monitor (non-major)',
      automerge: true,
    },
    {
      matchFileNames: [
        'all/**',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      groupName: 'all (non-major)',
      automerge: true,
    },
    {
      matchFileNames: [
        'all/**',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '!/^0/',
      groupName: 'all (non-major)',
      automerge: true,
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?.*?-ls(?<build>\\d+)$',
      matchPackageNames: [
        '/^(?:(?:gh|ls)cr\\.io/)?linuxserver//',
      ],
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'linuxserver/jellyfin',
        'linuxserver/overseerr',
        'linuxserver/tautulli',
      ],
      allowedVersions: '<2000', // There is 2021.x.x tags and ancient 20201215 tags
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'linuxserver/sonarr',
      ],
      allowedVersions: '!/^5\\./', // Ancient mono 5.14-2.0.0.5344 tags
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'linuxserver/calibre-web',
      ],
      allowedVersions: '<2', // Actual versions are 0.x. There is 2021.x.x and v2, v3, v4 tags... 
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'linuxserver/qbittorrent',
      ],
      allowedVersions: '<10', // Actual version is 3.x.x. There is 14.x.x, 20.x.x tags...
    },
    {
      // Les versions stables 14.x de Seafile Pro (ex: 14.0.9) n'ont pas de manifest ARM64 (amd64 uniquement).
      // On configure Renovate pour suivre les tags -arm-testing afin de tester les mises à jour ARM.
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'seafileltd/seafile-pro-mc',
      ],
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?-arm-testing$',
    }
  ],
}
