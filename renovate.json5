{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'Europe/Paris',
  'docker-compose': {
    fileMatch: [
      '^.*\\.ya?ml$',
    ],
  },
  assignees: [
    'TheToto',
  ],
  automerge: false,
  ignoreTests: true,
  automergeSchedule: [
    'after 1:00am and before 6:00am',
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '!/^0/',
      automerge: true,
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackagePatterns: [
        '^(gh|ls)cr\\.io/linuxserver/',
      ],
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?.*?-ls(?<build>\\d+)$',
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'lscr.io/linuxserver/jellyfin',
        'lscr.io/linuxserver/overseerr',
        'lscr.io/linuxserver/tautulli',
      ],
      allowedVersions: '<2000', // There is 2021.x.x tags and ancient 20201215 tags
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'lscr.io/linuxserver/sonarr',
      ],
      allowedVersions: '!/^5\\./', // Ancient mono 5.14-2.0.0.5344 tags
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'lscr.io/linuxserver/calibre-web',
      ],
      allowedVersions: '<2', // Actual versions are 0.x. There is 2021.x.x and v2, v3, v4 tags... 
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'lscr.io/linuxserver/qbittorrent',
      ],
      allowedVersions: '<10', // Actual version is 3.x.x. There is 14.x.x, 20.x.x tags...
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'getmeili/meilisearch',
      ],
      allowedVersions: '<1.10', // Limit to 1.9
    },
  ],
}
